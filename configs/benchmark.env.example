# Export explicitly from the repository root; scripts do not auto-load this file:
# set -a; source configs/benchmark.env.example; set +a
RUNS=3
CONTEXT_SIZE=512
PREDICT_TOKENS=128
BATCH_SIZE=32
MICROBATCH_SIZE=1
CPU_THREADS=6
DEVICE=ROCm0
FLASH_ATTENTION=off
